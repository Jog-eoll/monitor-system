# ========== terminal-gateway 一键部署配置模板 ==========
# 复制此文件为 deploy.conf 并填写实际值
# 命令: cp deploy.conf.example deploy.conf

# ========== 服务器基础配置 ==========
# 最低硬件要求
MIN_CPU_CORES=2
MIN_MEMORY_MB=4096
MIN_DISK_GB=30

# ========== MySQL 数据库配置 ==========
# 模式1：使用本地 MySQL 容器（推荐，自动初始化）
# 设置 DB_HOST=127.0.0.1，安装器会自动启动 MySQL 容器并初始化数据库
# 模式2：使用外部 MySQL 服务器
# 设置 DB_HOST 为外部 MySQL 地址，需要提前手动创建数据库
DB_HOST='127.0.0.1'
DB_PORT='3306'
DB_NAME='terminal_gateway'
DB_USERNAME='root'
DB_PASSWORD='Replace_Mysql_Password_2026!'
DB_ROOT_PASSWORD='Replace_Mysql_Root_2026!'

# ========== 管控平台配置 ==========
# 管控平台地址（用于设备注册、状态上报）
MONITOR_HOST='192.168.1.233'
MONITOR_UKEY_PORT='8080'
MONITOR_DEVICE_PORT='8080'
MONITOR_CONTENT_PORT='8080'
MONITOR_LOG_URL='http://192.168.1.233:8080'

# ========== VAuth 国密配置 ==========
# UKey/SDF 密码卡配置
VAUTH_MOCK_MODE='false'
VAUTH_PASSWORD='88888888'
VAUTH_AUTH_ID='44030000003330000310'
VAUTH_SERVER_ID='44010100003330003024'
VAUTH_SVAC_MODE='true'

# ========== JmDNS 服务发现配置 ==========
PROVIDER_JMDNS_ENABLED='true'
PROVIDER_JMDNS_BIND_ADDRESS='192.168.1.26'
PROVIDER_JMDNS_ADVERTISE_HOST='192.168.1.26'

# ========== 设备注册配置 ==========
REGISTRY_CLIENT_ID='terminal-udp-gateway-192.168.1.26-8093'
DEVICE_VERSION='1.0.0'
DEVICE_LOCATION=''
DEVICE_MANUFACTURER=''
DEVICE_MODEL=''
DEVICE_REMARK='terminal decrypt gateway'

# ========== 截图配置（可选） ==========
SNAPSHOT_ENABLED=false
SNAPSHOT_INTERVAL_SECONDS=10
SNAPSHOT_TIMEOUT_MS=5000

# ========== MinIO 配置（可选，用于截图上传） ==========
MINIO_ENABLED=false
MINIO_ENDPOINT=http://192.168.1.31:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY='Replace_Minio_Secret_2026!'

# ========== 端口配置 ==========
# 解密网关主服务端口
GATEWAY_HTTP_PORT=8093

# ========== 安装器配置 ==========
# 是否允许从网络拉取 Docker 镜像
PULL_PUBLIC_IMAGES=false
# 是否自动开放防火墙端口
AUTO_OPEN_FIREWALL=true
# 是否自动安装 Docker（不推荐，建议提前手动安装）
AUTO_INSTALL_DOCKER=false
