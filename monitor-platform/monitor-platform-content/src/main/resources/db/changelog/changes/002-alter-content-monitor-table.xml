<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002-add-content-monitor-reason" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="t_content_monitor"/>
                <not>
                    <columnExists tableName="t_content_monitor" columnName="reason"/>
                </not>
            </and>
        </preConditions>

        <comment>为内容监控表添加AI判定依据字段</comment>
        
        <addColumn tableName="t_content_monitor">
            <column name="reason" type="VARCHAR(500)" remarks="AI判定依据"/>
        </addColumn>
    </changeSet>

    <changeSet id="002-add-content-monitor-request-id" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="t_content_monitor"/>
                <not>
                    <columnExists tableName="t_content_monitor" columnName="request_id"/>
                </not>
            </and>
        </preConditions>

        <comment>为内容监控表添加阿里云请求追踪ID字段</comment>

        <addColumn tableName="t_content_monitor">
            <column name="request_id" type="VARCHAR(100)" remarks="阿里云请求追踪ID"/>
        </addColumn>
    </changeSet>

    <changeSet id="002-add-content-monitor-error-message" author="system">
        <preConditions onFail="MARK_RAN">
            <and>
                <tableExists tableName="t_content_monitor"/>
                <not>
                    <columnExists tableName="t_content_monitor" columnName="error_message"/>
                </not>
            </and>
        </preConditions>

        <comment>为内容监控表添加检测失败错误信息字段</comment>

        <addColumn tableName="t_content_monitor">
            <column name="error_message" type="VARCHAR(500)" remarks="检测失败错误信息"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
