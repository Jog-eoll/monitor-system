<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003" author="system">
        
<preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="terminal_app_info"/>
            </not>
        </preConditions>

<comment>创建终端应用程序信息表</comment><createTable tableName="terminal_app_info" remarks="终端应用程序信息表">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            
            <column name="app_id" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            
            <column name="app_name" type="VARCHAR(100)"/>
            
            <column name="version" type="VARCHAR(50)"/>
            
            <column name="status" type="VARCHAR(20)" defaultValue="正常"/>
            
            <column name="total_count" type="INT" defaultValue="0"/>
            
            <column name="normal_count" type="INT" defaultValue="0"/>
            
            <column name="abnormal_count" type="INT" defaultValue="0"/>
            
            <column name="ip_address" type="VARCHAR(50)"/>
            
            <column name="location" type="VARCHAR(100)"/>
            
            <column name="description" type="VARCHAR(500)"/>
            
            <column name="last_online_time" type="DATETIME"/>
            
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            
            <column name="update_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            
            <column name="remark" type="VARCHAR(500)"/>
        </createTable>
        
        <addUniqueConstraint tableName="terminal_app_info" columnNames="app_id" constraintName="uk_terminal_app_info_app_id"/>
        <createIndex tableName="terminal_app_info" indexName="idx_terminal_app_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="terminal_app_info" indexName="idx_terminal_app_location">
            <column name="location"/>
        </createIndex>
        <createIndex tableName="terminal_app_info" indexName="idx_terminal_app_create_time">
            <column name="create_time"/>
        </createIndex>
        
    </changeSet>

</databaseChangeLog>
