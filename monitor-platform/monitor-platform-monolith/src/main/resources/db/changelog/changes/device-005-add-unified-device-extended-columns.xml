<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="device-005-add-unified-device-mac" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="unified_device_info"/>
                <not>
                    <columnExists tableName="unified_device_info" columnName="mac"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="unified_device_info">
            <column name="mac" type="VARCHAR(64)" remarks="mac address"/>
        </addColumn>
    </changeSet>

