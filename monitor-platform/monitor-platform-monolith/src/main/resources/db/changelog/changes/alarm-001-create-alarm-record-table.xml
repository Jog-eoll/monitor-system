<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001" author="system">
        
<preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="alarm_record"/>
            </not>
        </preConditions>

<comment>创建告警记录表</comment><createTable tableName="alarm_record" remarks="告警记录表">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            
            <column name="alarm_type" type="VARCHAR(50)" remarks="告警类型: content_violation/device_offline/config_fail">
                <constraints nullable="false"/>
            </column>
            
            <column name="alarm_level" type="VARCHAR(20)" defaultValue="general" remarks="告警级别: critical/serious/general/minor"/>
            <column name="device_id" type="VARCHAR(64)"/>
            <column name="device_name" type="VARCHAR(100)"/>
            <column name="content_id" type="VARCHAR(64)"/>
            <column name="violation_type" type="VARCHAR(100)"/>
            <column name="violation_detail" type="TEXT"/>
            
            <column name="alarm_time" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            
            <column name="handle_status" type="VARCHAR(20)" defaultValue="pending" remarks="处理状态: pending/processed/reviewing"/>
            <column name="handle_operator" type="VARCHAR(50)"/>
            <column name="handle_time" type="DATETIME"/>
            <column name="handle_remark" type="VARCHAR(500)"/>
            
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            
            <column name="content_type" type="VARCHAR(20)" remarks="违规内容类型：text/image/video"/>
            <column name="content_data" type="TEXT" remarks="违规文本内容"/>
            <column name="content_file_url" type="VARCHAR(500)" remarks="违规内容访问URL"/>
        </createTable>
        
        <createIndex tableName="alarm_record" indexName="idx_alarm_type">
            <column name="alarm_type"/>
        </createIndex>
        
        <createIndex tableName="alarm_record" indexName="idx_alarm_level">
            <column name="alarm_level"/>
        </createIndex>
        
        <createIndex tableName="alarm_record" indexName="idx_device_id">
            <column name="device_id"/>
        </createIndex>
        
        <createIndex tableName="alarm_record" indexName="idx_content_id">
            <column name="content_id"/>
        </createIndex>
        
        <createIndex tableName="alarm_record" indexName="idx_handle_status">
            <column name="handle_status"/>
        </createIndex>
        
        <createIndex tableName="alarm_record" indexName="idx_alarm_time">
            <column name="alarm_time"/>
        </createIndex>
        
    </changeSet>

</databaseChangeLog>
