<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="forward-010-create-device-mqtt-command" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="device_mqtt_command"/>
            </not>
        </preConditions>
        <createTable tableName="device_mqtt_command" remarks="MQTT command dispatch record">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="id">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="message_id" type="VARCHAR(64)" remarks="message id">
                <constraints nullable="false"/>
            </column>
            <column name="tenant_id" type="VARCHAR(64)" remarks="tenant id"/>
            <column name="site_id" type="VARCHAR(64)" remarks="site id"/>
            <column name="gateway_device_id" type="VARCHAR(128)" remarks="gateway device id">
                <constraints nullable="false"/>
            </column>
            <column name="target_device_id" type="VARCHAR(128)" remarks="target device id"/>
            <column name="business_id" type="VARCHAR(128)" remarks="business id"/>
            <column name="command" type="VARCHAR(128)" remarks="command">
                <constraints nullable="false"/>
            </column>
            <column name="message_type" type="VARCHAR(32)" remarks="message type"/>
            <column name="topic" type="VARCHAR(512)" remarks="MQTT topic"/>
            <column name="payload_json" type="TEXT" remarks="command payload json"/>
            <column name="status" type="VARCHAR(32)" defaultValue="CREATED" remarks="command status">
                <constraints nullable="false"/>
            </column>
            <column name="qos" type="INT" remarks="MQTT QoS"/>
            <column name="retry_count" type="INT" defaultValue="0" remarks="retry count"/>
            <column name="timeout_at" type="DATETIME" remarks="timeout time"/>
            <column name="published_at" type="DATETIME" remarks="published time"/>
            <column name="ack_time" type="DATETIME" remarks="reply time"/>
            <column name="error_message" type="VARCHAR(1024)" remarks="error message"/>
            <column name="error_code" type="VARCHAR(64)" remarks="error code"/>
            <column name="reply_payload" type="TEXT" remarks="reply payload json"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP" remarks="create time"/>
            <column name="update_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP" remarks="update time"/>
        </createTable>

        <createIndex tableName="device_mqtt_command" indexName="uk_dmc_message_id" unique="true">
            <column name="message_id"/>
        </createIndex>
        <createIndex tableName="device_mqtt_command" indexName="idx_dmc_gateway_device_id">
            <column name="gateway_device_id"/>
        </createIndex>
        <createIndex tableName="device_mqtt_command" indexName="idx_dmc_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="device_mqtt_command" indexName="idx_dmc_timeout_at">
            <column name="timeout_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="forward-011-add-mqtt-command-reply-fields" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <and>
                <tableExists tableName="device_mqtt_command"/>
                <not>
                    <columnExists tableName="device_mqtt_command" columnName="business_id"/>
                </not>
            </and>
        </preConditions>
        <addColumn tableName="device_mqtt_command">
            <column name="business_id" type="VARCHAR(128)" remarks="business id"/>
            <column name="error_code" type="VARCHAR(64)" remarks="error code"/>
            <column name="reply_payload" type="TEXT" remarks="reply payload json"/>
        </addColumn>
    </changeSet>

    <changeSet id="forward-012-create-device-mqtt-command-event" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="device_mqtt_command_event"/>
            </not>
        </preConditions>
        <createTable tableName="device_mqtt_command_event" remarks="MQTT command event table">
            <column name="id" type="BIGINT" autoIncrement="true" remarks="id">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="command_message_id" type="VARCHAR(64)" remarks="command message id">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)" remarks="status">
                <constraints nullable="false"/>
            </column>
            <column name="event_payload" type="TEXT" remarks="event payload json"/>
            <column name="event_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP" remarks="event time"/>
        </createTable>
        <createIndex tableName="device_mqtt_command_event" indexName="idx_dmce_message_id">
            <column name="command_message_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
