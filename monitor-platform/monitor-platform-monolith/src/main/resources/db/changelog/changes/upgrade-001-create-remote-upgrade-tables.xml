<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="upgrade-001-create-remote-upgrade-package" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="remote_upgrade_package"/>
            </not>
        </preConditions>
        <createTable tableName="remote_upgrade_package" remarks="远程升级包">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="package_code" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="package_name" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="package_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="device_type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="target_version" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="storage_type" type="VARCHAR(32)" defaultValue="MINIO"/>
            <column name="object_name" type="VARCHAR(512)"/>
            <column name="download_url" type="VARCHAR(1024)"/>
            <column name="sha256" type="VARCHAR(64)"/>
            <column name="file_size" type="BIGINT"/>
            <column name="status" type="VARCHAR(32)" defaultValue="ACTIVE"/>
            <column name="remark" type="VARCHAR(512)"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="update_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex tableName="remote_upgrade_package" indexName="uk_upgrade_package_code" unique="true">
            <column name="package_code"/>
        </createIndex>
        <createIndex tableName="remote_upgrade_package" indexName="idx_upgrade_package_device_type">
            <column name="device_type"/>
        </createIndex>
    </changeSet>

    <changeSet id="upgrade-001-create-remote-upgrade-task" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="remote_upgrade_task"/>
            </not>
        </preConditions>
        <createTable tableName="remote_upgrade_task" remarks="远程升级任务">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_code" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="task_name" type="VARCHAR(128)"/>
            <column name="package_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="package_code" type="VARCHAR(64)"/>
            <column name="package_type" type="VARCHAR(32)"/>
            <column name="target_version" type="VARCHAR(64)"/>
            <column name="status" type="VARCHAR(32)" defaultValue="CREATED"/>
            <column name="total_count" type="INT" defaultValueNumeric="0"/>
            <column name="success_count" type="INT" defaultValueNumeric="0"/>
            <column name="failed_count" type="INT" defaultValueNumeric="0"/>
            <column name="timeout_count" type="INT" defaultValueNumeric="0"/>
            <column name="rollback_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
            <column name="timeout_seconds" type="INT" defaultValueNumeric="1800"/>
            <column name="operator" type="VARCHAR(64)"/>
            <column name="remark" type="VARCHAR(512)"/>
            <column name="start_time" type="DATETIME"/>
            <column name="finish_time" type="DATETIME"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="update_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex tableName="remote_upgrade_task" indexName="uk_upgrade_task_code" unique="true">
            <column name="task_code"/>
        </createIndex>
        <createIndex tableName="remote_upgrade_task" indexName="idx_upgrade_task_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="upgrade-001-create-remote-upgrade-task-device" author="system">
        <preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="remote_upgrade_task_device"/>
            </not>
        </preConditions>
        <createTable tableName="remote_upgrade_task_device" remarks="远程升级任务设备明细">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="task_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="task_code" type="VARCHAR(64)"/>
            <column name="target_device_id" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="device_type" type="VARCHAR(64)"/>
            <column name="current_version" type="VARCHAR(64)"/>
            <column name="target_version" type="VARCHAR(64)"/>
            <column name="mqtt_command_id" type="BIGINT"/>
            <column name="mqtt_message_id" type="VARCHAR(64)"/>
            <column name="status" type="VARCHAR(32)" defaultValue="CREATED"/>
            <column name="stage" type="VARCHAR(64)"/>
            <column name="progress" type="INT" defaultValueNumeric="0"/>
            <column name="error_message" type="VARCHAR(1024)"/>
            <column name="command_time" type="DATETIME"/>
            <column name="ack_time" type="DATETIME"/>
            <column name="finish_time" type="DATETIME"/>
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="update_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex tableName="remote_upgrade_task_device" indexName="idx_upgrade_task_device_task">
            <column name="task_id"/>
        </createIndex>
        <createIndex tableName="remote_upgrade_task_device" indexName="idx_upgrade_task_device_target">
            <column name="target_device_id"/>
        </createIndex>
        <createIndex tableName="remote_upgrade_task_device" indexName="idx_upgrade_task_device_msg">
            <column name="mqtt_message_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
