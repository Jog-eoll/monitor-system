<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="001" author="system">
        
<preConditions onFail="MARK_RAN" onError="HALT">
            <not>
                <tableExists tableName="content_detection_task"/>
            </not>
        </preConditions>

<comment>创建内容检测任务队列表</comment><createTable tableName="content_detection_task" remarks="检测任务队列表">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            
            <column name="business_id" type="VARCHAR(100)" remarks="业务唯一标识">
                <constraints nullable="false" unique="true"/>
            </column>
            
            <column name="device_id" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            
            <column name="device_name" type="VARCHAR(200)"/>
            <column name="screenshot_base64" type="LONGTEXT" remarks="截图Base64编码(WebP格式)"/>
            
            <column name="task_status" type="VARCHAR(20)" defaultValue="pending" remarks="任务状态: pending/processing/completed/failed"/>
            <column name="retry_count" type="INT" defaultValue="0"/>
            <column name="max_retry" type="INT" defaultValue="3"/>
            <column name="priority" type="INT" defaultValue="0"/>
            
            <column name="submit_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="start_time" type="DATETIME"/>
            <column name="complete_time" type="DATETIME"/>
            
            <column name="error_message" type="TEXT"/>
            
            <column name="create_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="update_time" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP"/>
        </createTable>
        
        <createIndex tableName="content_detection_task" indexName="idx_business_id">
            <column name="business_id"/>
        </createIndex>
        
        <createIndex tableName="content_detection_task" indexName="idx_device_id">
            <column name="device_id"/>
        </createIndex>
        
        <createIndex tableName="content_detection_task" indexName="idx_task_status">
            <column name="task_status"/>
        </createIndex>
        
        <createIndex tableName="content_detection_task" indexName="idx_priority">
            <column name="priority"/>
        </createIndex>
        
        <createIndex tableName="content_detection_task" indexName="idx_submit_time">
            <column name="submit_time"/>
        </createIndex>
        
    </changeSet>

</databaseChangeLog>
