<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="002" author="system">
        <comment>创建菜单权限表</comment>
        
        <createTable tableName="permission" remarks="菜单权限表">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            
            <column name="type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            
            <column name="code" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            
            <column name="route_url" type="VARCHAR(255)"/>
            
            <column name="plugin_url" type="VARCHAR(255)"/>
            
            <column name="icon_url" type="VARCHAR(255)"/>
            
            <column name="sort" type="INT" defaultValue="1">
                <constraints nullable="false"/>
            </column>
            
            <column name="is_enable" type="VARCHAR(20)" defaultValue="ENABLED">
                <constraints nullable="false"/>
            </column>
            
            <column name="parent_id" type="BIGINT" defaultValue="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <addUniqueConstraint tableName="permission" columnNames="code" constraintName="uk_permission_code"/>
        <createIndex tableName="permission" indexName="idx_permission_parent_sort">
            <column name="parent_id"/>
            <column name="sort"/>
        </createIndex>
        
    </changeSet>

</databaseChangeLog>
