# Stage 1 standard deployment environment.
# Copy this file to deploy.env and replace values for the target site.

# Scenario: full_platform, lite_platform, one_to_one, one_to_many
DEPLOY_SCENARIO=one_to_many

# Platform identity
PLATFORM_CODE=monitor_platform_monolith
PLATFORM_HOST=192.168.1.10
PLATFORM_HTTP_PORT=18080
PLATFORM_HTTPS_PORT=18443
PLATFORM_API_GATEWAY_PORT=8060
MONOLITH_PORT=18081

# Common policy
FORBID_COMMON_HOST_PORTS=true
ALLOW_SSH_PORT_22=true
LOG_LEVEL=INFO

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=23306
MYSQL_DATABASE=monitor_platform
MYSQL_USERNAME=monitor_app
MYSQL_PASSWORD=S9x@MonitorDb!2026
MYSQL_ROOT_PASSWORD=S9x@MonitorRoot!2026

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=26379
REDIS_PASSWORD=S9x@MonitorRedis!2026

# Nacos
NACOS_HOST=127.0.0.1
NACOS_PORT=18848
NACOS_NAMESPACE=5c87647a-8a17-4adb-94ce-04047ea26d96

# Sentinel
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=18858

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:19000
MINIO_ROOT_USER=monitor_minio
MINIO_ROOT_PASSWORD=S9x@MonitorMinioRoot!2026
MINIO_ACCESS_KEY=monitor_access_key
MINIO_SECRET_KEY=S9x@MonitorMinioSecret!2026
MINIO_BUCKET=monitor-platform

# UKey admin
UKEY_ADMIN_USERNAME=monitor_ukey
UKEY_ADMIN_PASSWORD=S9x@MonitorUkey!2026

# VAuth server
VAUTH_SERVER_MODE=ukey
VAUTH_SERVER_REQUIRED=true
VAUTH_SERVER_PASSWORD=S9x@MonitorVAuth!2026
VAUTH_SERVER_AUTH_ID=44010100003330003024
VAUTH_SERVER_UKEY_PATH=
VAUTH_SERVER_UKEY_SN=
VAUTH_SERVER_UKEY_CER_SN=
VAUTH_SERVER_UKEY_CER_ID=
VAUTH_SVAC_MODE=false

# Package paths, relative to this install package
CERT_DIR=certs
IMAGE_DIR=images
SDK_LIB_DIR=sdk/lib

# Stage 2 single-node MVP
INSTALL_DIR=/opt/monitor-platform-single-node
MYSQL_IMAGE=mysql:5.7
REDIS_IMAGE=redis:latest
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest
MONOLITH_IMAGE=monitor-platform-monolith:1.0.0
MINIO_CONSOLE_PORT=19002
PULL_MISSING_IMAGES=false
HEALTH_RETRIES=40
HEALTH_INTERVAL_SECONDS=5

# Optional feature switches
AUDIT_MODE=local
LOCAL_AUDIT_IMAGE_URL=http://127.0.0.1:18088/api/audit/image
LOG_REPORT_TOKEN=
