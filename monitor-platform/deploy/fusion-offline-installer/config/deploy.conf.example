# 网关平台一体化部署配置示例
# 使用方式：
# 1. cp config/deploy.conf.example config/deploy.conf
# 2. 按现场环境填写 config/deploy.conf
# 3. sudo ./install.sh --validate
# 4. sudo ./install.sh --deploy
# 注意：值中包含空格、$、`、' 等特殊字符时，请使用单引号包裹，并按 Bash 规则转义。

# 部署目录，建议使用绝对路径。不要使用相对路径，避免 sudo 从其他目录执行时跑偏。
PLATFORM_DIR=/opt/monitor-platform-monolith
GATEWAY_DIR=/opt/publish-gateway

# 服务与镜像
PLATFORM_SERVICE=monitor-platform-monolith
GATEWAY_SERVICE=gateway-udp-proxy
PLATFORM_IMAGE=monitor-platform-monolith:1.0.0
GATEWAY_IMAGE=gateway-udp-proxy:1.0.0

# 访问地址与端口。SERVER_IP 填当前部署服务器对外服务 IP。
SERVER_IP=
PLATFORM_HTTP_PORT=8080
GATEWAY_HTTP_PORT=8092
CLIENT_RELAY_PORT=18092
MDNS_PORT=5353

# MQTT Agent。默认关闭；公网 EMQX 可达后改为 true。
MQTT_AGENT_ENABLED=false
MQTT_BROKER_URL=ssl://127.0.0.1:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=publish-gateway-001
MQTT_TENANT_ID=default
MQTT_SITE_ID=site-001
MQTT_RECONNECT_INTERVAL_MS=30000
MQTT_COMMAND_DEDUP_TTL_MS=86400000
MQTT_DEDUP_CLEANUP_INTERVAL_MS=600000

# MySQL。部署用户必须具备创建/访问 PLATFORM_DB_NAME 和 GATEWAY_DB_NAME 的权限。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USERNAME=
MYSQL_PASSWORD=
PLATFORM_DB_NAME=monitor_platform
GATEWAY_DB_NAME=udp_proxy_gateway

# Redis。无密码时 REDIS_PASSWORD 留空。
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
PLATFORM_REDIS_DB=0
GATEWAY_REDIS_DB=2

# MinIO。MINIO_PORT 填 API 端口，不是控制台端口。
MINIO_HOST=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=monitor-content

# 平台 UKey 管理员、JWT 和 JVM。JWT_SECRET 可选；留空时部署脚本会自动生成并写回 config/deploy.conf。
UKEY_ADMIN_USERNAME=monitor_ukey
UKEY_ADMIN_PASSWORD=
JWT_SECRET=
JWT_EXPIRE_HOURS=8
JAVA_OPTS='-Xms512m -Xmx1024m'

# UKey 配置模式：
# deferred = 现场暂缺 UKey，先完成基础部署，网关使用模拟加密启动
# required = 本次直接启用正式国密链路，必须填写 PIN 和 AUTH_ID；path/sn/cerSn/cerId 可留空，由脚本自动识别并写回。
UKEY_SETUP_MODE=required

# 平台 UKey，认证服务端。UKEY_SETUP_MODE=required 时 PLATFORM_UKEY_PIN 和 PLATFORM_AUTH_ID 必填。
PLATFORM_UKEY_PIN=
PLATFORM_AUTH_ID=
# 以下 PLATFORM_UKEY_* 绑定字段可留空，脚本会通过 tools/ukey-list 按 PLATFORM_AUTH_ID 自动回填。
PLATFORM_UKEY_PATH=
PLATFORM_UKEY_SN=
PLATFORM_UKEY_CER_SN=
PLATFORM_UKEY_CER_ID=

# 加密网关 UKey，认证客户端。UKEY_SETUP_MODE=required 时 GATEWAY_UKEY_PIN 和 GATEWAY_AUTH_ID 必填。
GATEWAY_UKEY_PIN=
GATEWAY_AUTH_ID=
# 以下 GATEWAY_UKEY_* 绑定字段可留空，脚本会通过 tools/ukey-list 按 GATEWAY_AUTH_ID 自动回填。
GATEWAY_UKEY_PATH=
GATEWAY_UKEY_SN=
GATEWAY_UKEY_CER_SN=
GATEWAY_UKEY_CER_ID=
# 平台注册用网关证书编号；可等于 GATEWAY_AUTH_ID，也可为带后缀的证书编号，例如 44030000013200000623_18530D。
GATEWAY_CERT_SERIAL_NO=

# 加密网关设备信息
DEVICE_VERSION=1.0.0
DEVICE_LOCATION=
DEVICE_MANUFACTURER=
DEVICE_MODEL=
DEVICE_REMARK=

# 可选安全发布包配置
SECURE_PUBLISH_ENABLED=true
SECURE_PUBLISH_TRUSTED_KEY_IDS=
SECURE_PUBLISH_DEFAULT_KEY_ID=default
SECURE_PUBLISH_VERIFIER_PUBLIC_KEY_PATH=

# 检查策略
HEALTH_RETRIES=60
HEALTH_INTERVAL_SECONDS=5
LOG_VERIFY_RETRIES=36
LOG_VERIFY_INTERVAL_SECONDS=5
