# ============================================================
# Monitor Platform Deployment Environment Template
# Usage:
#   1. Copy this file to .env in the same directory as docker-compose.yml.
#   2. Replace every CHANGE_ME value before running docker compose.
# ============================================================

# ---------- EMQX MQTT Broker ----------
# Dashboard credentials (production must change)
EMQX_DASHBOARD_PASSWORD=CHANGE_ME_emqx_dashboard_password

# MQTT ports
EMQX_MQTT_PORT=1883
EMQX_MQTTS_PORT=8883
EMQX_DASHBOARD_PORT=18083

# Platform MQTT credentials (MANDATORY - empty passwords not allowed)
MQTT_BROKER_URL=ssl://mqtt.CHANGE_ME_DOMAIN:8883
MQTT_USERNAME=CHANGE_ME_platform_mqtt_username
MQTT_PASSWORD=CHANGE_ME_platform_mqtt_password
MQTT_TENANT_ID=default
MQTT_SITE_ID=site-001
MQTT_PLATFORM_CLIENT_ID=monitor-platform-001
MQTT_RECONNECT_INTERVAL_MS=30000

# Device default password (MANDATORY - shared by all field gateways)
MQTT_DEFAULT_DEVICE_PASSWORD=CHANGE_ME_device_shared_secret

# TLS truststore (leave empty for public CA; required for private CA)
MQTT_TRUSTSTORE_PATH=
MQTT_TRUSTSTORE_PASSWORD=

# ---------- Dispatcher ----------
DISPATCH_MODE=http

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_USERNAME=CHANGE_ME_mysql_app_user
MYSQL_PASSWORD=CHANGE_ME_mysql_app_password
MYSQL_IP_PORT=127.0.0.1:23306
MYSQL_DB=monitor_platform
MYSQL_HOST_PORT=23306

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_HOST_PORT=26379

# ---------- MinIO ----------
MINIO_ROOT_USER=CHANGE_ME_minio_root_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_password
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET_NAME=monitor-content
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19002

# ---------- NACOS ----------
NACOS_IP_PORT=127.0.0.1:18848
NACOS_NAMESPACE=public
NACOS_HOST_PORT=18848

# ---------- Dispatch Forward ----------
MONITOR_DEVICE_URL=http://127.0.0.1:8062
MONITOR_LOG_URL=http://127.0.0.1:8071
LOG_REPORT_TOKEN=CHANGE_ME_log_report_token
LOG_RETENTION_DAYS=90

# ---------- UKey / VAuth ----------
VAUTH_SERVER_MODE=ukey
VAUTH_SERVER_PASSWORD=CHANGE_ME_vauth_server_password
VAUTH_SERVER_AUTH_ID=

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME_jwt_secret_key
JWT_EXPIRE_HOURS=8
