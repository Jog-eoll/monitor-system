# ============================================================
# publish-gateway deployment environment template
# Usage:
#   1. Copy this file to .env in the same directory as docker-compose.yml.
#   2. Replace every CHANGE_ME value before running docker compose.
#   3. Keep this file in Linux LF format if possible.
# ============================================================

# ---------- MySQL started by this docker-compose ----------
# Host port exposed only on 127.0.0.1. Keep 3307 if the server already has MySQL on 3306.
MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_APP_USER=udp_proxy_app
MYSQL_APP_PASSWORD=CHANGE_ME_mysql_app_password

# ---------- Redis started by this docker-compose ----------
REDIS_HOST_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password

# ---------- Monitor platform ----------
# Example: 192.168.1.233. Do not include http://.
MONITOR_HOST=CHANGE_ME_monitor_platform_host
MONITOR_DEVICE_PORT=8062
MONITOR_CONTENT_PORT=8065
MONITOR_UKEY_PORT=8063
MONITOR_LOG_URL=http://CHANGE_ME_monitor_platform_host:8071

# ---------- MQTT Agent ----------
# MQTT is the standard primary downlink. Set false only when downgrading to HTTP mode.
MQTT_AGENT_ENABLED=true
MQTT_BROKER_URL=ssl://mqtt.CHANGE_ME_DOMAIN:8883
MQTT_USERNAME=CHANGE_ME_mqtt_username
MQTT_PASSWORD=CHANGE_ME_mqtt_password
MQTT_CLIENT_ID=publish-gateway-001
MQTT_TENANT_ID=default
MQTT_SITE_ID=site-001
MQTT_RECONNECT_INTERVAL_MS=30000
MQTT_COMMAND_DEDUP_TTL_MS=86400000
MQTT_DEDUP_CLEANUP_INTERVAL_MS=600000
# TLS 信任库（公共 CA 证书留空；公司内部 CA 时必须配置 JKS/PKCS12 文件路径）
MQTT_TRUSTSTORE_PATH=
MQTT_TRUSTSTORE_PASSWORD=

# ---------- MinIO ----------
# Example: 192.168.1.233 and 9000. Do not include http://.
MINIO_HOST=CHANGE_ME_minio_host
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key
MINIO_BUCKET=monitor-content

# ---------- UKey / VAuth ----------
# VAUTH_AUTH_ID and VAUTH_SERVER_ID must match certificate files under ./certs:
#   ./certs/${VAUTH_AUTH_ID}_SIGN.cer
#   ./certs/${VAUTH_SERVER_ID}_SIGN.cer
VAUTH_DEVICE_TYPE=ukey
VAUTH_PASSWORD=CHANGE_ME_vauth_password
VAUTH_AUTH_ID=CHANGE_ME_client_auth_id
VAUTH_SERVER_ID=CHANGE_ME_server_id
# Same-host dual UKey deployment: bind publish-gateway to its own UKey.
# Prefer VAUTH_UKEY_SN. Keep path empty unless the vendor confirms path stability.
VAUTH_UKEY_PATH=
VAUTH_UKEY_SN=CHANGE_ME_publish_gateway_ukey_sn
VAUTH_UKEY_CER_SN=
VAUTH_UKEY_CER_ID=
VAUTH_SVAC_MODE=false

# ---------- Sigma Play secure package verification ----------
# Current signing-machine keyId is "default". If the signer is changed to
# spkg-prod-01, rename ./trust/default.pub and update both key-id variables.
SECURE_PUBLISH_ENABLED=false
SECURE_PUBLISH_TRUST_STORE_DIR=/opt/publish-gateway/trust
SECURE_PUBLISH_TRUSTED_KEY_IDS=default
SECURE_PUBLISH_DEFAULT_KEY_ID=default
SECURE_PUBLISH_VERIFIER_PUBLIC_KEY_PATH=
SECURE_PUBLISH_PACKAGE_EXTENSIONS=tar,spkg,zip
SECURE_PUBLISH_MAX_PACKAGE_SIZE_MB=500

# ---------- info-publish-client relay ----------
CLIENT_RELAY_ENABLED=true
CLIENT_RELAY_PORT=18092
CLIENT_RELAY_TRUSTED_IPS=
CLIENT_RELAY_VERIFY_SIGNATURE=false
CLIENT_RELAY_SIGNATURE_SECRET=
CLIENT_RELAY_REJECT_DIRECT_UDP=false

# ---------- Device registry metadata ----------
# These values are optional, but keeping them explicit makes registration easier to identify.
# Empty REGISTRY_CLIENT_ID falls back to VAUTH_AUTH_ID in application.yml.
REGISTRY_CLIENT_ID=
DEVICE_LOCATION=
DEVICE_VERSION=1.0.0
DEVICE_MANUFACTURER=
DEVICE_MODEL=gateway-udp-proxy
DEVICE_REMARK=

# ---------- LAN discovery ----------
# Set to false if UDP multicast 224.0.0.251:5353 is unavailable in the deployment network.
PROVIDER_JMDNS_ENABLED=true
PROVIDER_JMDNS_BIND_ADDRESS=
PROVIDER_JMDNS_ADVERTISE_HOST=
